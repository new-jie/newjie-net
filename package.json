{
  "name": "blog",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "preview:cf": "npm run build && wrangler dev --port 8788 --ip 127.0.0.1",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "gen:theme": "node scripts/gen-theme.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:anchors": "node scripts/check-anchors.mjs",
    "check:callouts": "node scripts/check-callouts.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "verify": "npm run check:icons && npm run check:anchors && npm run check && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@ktibow/material-color-utilities-nightly": "0.4.01772748028000",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "24.13.5",
    "m3-svelte": "7.2.0",
    "mdsvex": "0.12.8",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-functions-mixins": "0.4.1",
    "wrangler": "4.132.0"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260915.1": true
  }
}
